{
	"version": "16.0.0",
	"private": true,
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"upgrade-all": "npx npm-check-updates -u && yarn install",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --build tsconfig.json",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"frappe-types": "^16.5.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
